import logging

from clientes import Cliente
from servicios import (
    ReservaSala,
    AlquilerEquipo,
    AsesoriaEspecializada
)
from reservas import Reserva
from excepciones import (
    DatosInvalidosError,
    ClienteNoEncontradoError,
    ServicioNoDisponibleError
)


# ==========================================
# CONFIGURACION DEL ARCHIVO DE REGISTRO
# ==========================================

logging.basicConfig(
    filename="software_fj.log",
    level=logging.INFO,
    format="%(asctime)s - %(levelname)s - %(message)s"
)

logger = logging.getLogger("SoftwareFJ")


# ==========================================
# CLASE PRINCIPAL DEL SISTEMA
# ==========================================

class SistemaSoftwareFJ:

    def __init__(self):
        # Listas internas de objetos
        self.clientes = []
        self.servicios = []
        self.reservas = []

    def registrar_cliente(self, cliente):
        if any(c.identificador == cliente.identificador
               for c in self.clientes):
            raise DatosInvalidosError(
                "Ya existe un cliente con ese identificador."
            )

        self.clientes.append(cliente)
        logger.info("Cliente registrado: %s", cliente.identificador)

        return "Cliente registrado correctamente."

    def registrar_servicio(self, servicio):
        if any(s.identificador == servicio.identificador
               for s in self.servicios):
            raise DatosInvalidosError(
                "Ya existe un servicio con ese identificador."
            )

        self.servicios.append(servicio)
        logger.info("Servicio registrado: %s", servicio.identificador)

        return "Servicio registrado correctamente."

    def buscar_cliente(self, identificador):
        for cliente in self.clientes:
            if cliente.identificador == str(identificador):
                return cliente

        raise ClienteNoEncontradoError(
            "No se encontro el cliente solicitado."
        )

    def buscar_servicio(self, identificador):
        for servicio in self.servicios:
            if servicio.identificador == str(identificador):
                return servicio

        raise ServicioNoDisponibleError(
            "No se encontro el servicio solicitado."
        )

    def crear_reserva(self, identificador, id_cliente,
                      id_servicio, duracion):

        cliente = self.buscar_cliente(id_cliente)
        servicio = self.buscar_servicio(id_servicio)

        reserva = Reserva(
            identificador,
            cliente,
            servicio,
            duracion
        )

        self.reservas.append(reserva)

        logger.info("Reserva creada: %s", identificador)

        return reserva

    def listar_clientes(self):
        return [cliente.obtener_resumen()
                for cliente in self.clientes]

    def listar_servicios(self):
        return [servicio.describir_servicio()
                for servicio in self.servicios]

    def listar_reservas(self):
        return [reserva.obtener_resumen()
                for reserva in self.reservas]


# ==========================================
# FUNCION PARA EJECUTAR Y CONTROLAR ERRORES
# ==========================================

def ejecutar_operacion(numero, descripcion, funcion):

    print("\n------------------------------------------")
    print(f"OPERACION {numero}: {descripcion}")
    print("------------------------------------------")

    try:
        resultado = funcion()

    except Exception as error:
        logger.exception(
            "Error en la operacion %s: %s",
            numero,
            descripcion
        )
        print("Operacion controlada:", error)

    else:
        logger.info(
            "Operacion %s realizada correctamente.",
            numero
        )
        if resultado is not None:
            print(resultado)

    finally:
        print("Finalizacion de la operacion", numero)


# ==========================================
# EJECUCION DE LAS PRUEBAS
# ==========================================

def iniciar_sistema():

    sistema = SistemaSoftwareFJ()

    print("\n==========================================")
    print("       SISTEMA DE GESTION SOFTWARE FJ")
    print("==========================================")

    # OPERACION 1: Registrar cliente valido
    ejecutar_operacion(
        1,
        "Registrar cliente valido",
        lambda: sistema.registrar_cliente(
            Cliente(
                "C001",
                "Carlos Martinez",
                "carlos@gmail.com",
                "3001234567"
            )
        )
    )

    # OPERACION 2: Registrar segundo cliente
    ejecutar_operacion(
        2,
        "Registrar segundo cliente",
        lambda: sistema.registrar_cliente(
            Cliente(
                "C002",
                "Maria Rodriguez",
                "maria@gmail.com",
                "3101234567"
            )
        )
