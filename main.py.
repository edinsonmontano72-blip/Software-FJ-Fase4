    )

    # OPERACION 5: Registrar alquiler de equipos
    ejecutar_operacion(
        5,
        "Registrar servicio de alquiler de equipos",
        lambda: sistema.registrar_servicio(
            AlquilerEquipo(
                "S002",
                "Computador portatil",
                15000,
                "Portatil"
            )
        )
    )

    # OPERACION 6: Registrar asesoria especializada
    ejecutar_operacion(
        6,
        "Registrar asesoria especializada",
        lambda: sistema.registrar_servicio(
            AsesoriaEspecializada(
                "S003",
                "Asesoria informatica",
                80000,
                "Tecnologia"
            )
        )
    )

    # OPERACION 7: Intentar registrar servicio invalido
    ejecutar_operacion(
        7,
        "Registrar servicio con tarifa incorrecta",
        lambda: sistema.registrar_servicio(
            ReservaSala("S004", "Sala invalida", -1000, 10)
        )
    )

    # OPERACION 8: Crear una reserva valida
    ejecutar_operacion(
        8,
        "Crear reserva para un cliente registrado",
        lambda: sistema.crear_reserva(
            "R001", "C001", "S001", 2
        )
    )

    # OPERACION 9: Confirmar la reserva
    ejecutar_operacion(
        9,
        "Confirmar reserva R001",
        lambda: sistema.reservas[0].confirmar()
    )

    # OPERACION 10: Procesar la reserva
    ejecutar_operacion(
        10,
        "Procesar reserva y calcular costo",
        lambda: sistema.reservas[0].procesar(
            descuento=10,
            impuesto=19
        )
    )

    # OPERACION 11: Crear reserva con cliente inexistente
    ejecutar_operacion(
        11,
        "Crear reserva con cliente no registrado",
        lambda: sistema.crear_reserva(
            "R002", "C999", "S001", 1
        )
    )

    # OPERACION 12: Crear reserva con duracion invalida
    ejecutar_operacion(
        12,
        "Crear reserva con duracion incorrecta",
        lambda: sistema.crear_reserva(
            "R003", "C002", "S002", -2
        )
    )

    # OPERACION 13: Crear y cancelar otra reserva
    ejecutar_operacion(
        13,
        "Crear reserva para cancelar",
        lambda: sistema.crear_reserva(
            "R004", "C002", "S003", 1
        )
    )

    ejecutar_operacion(
        14,
        "Cancelar reserva R004",
        lambda: sistema.reservas[-1].cancelar()
    )

    # ==========================================
    # MOSTRAR RESULTADOS FINALES
    # ==========================================

    print("\n==========================================")
    print("          RESUMEN DEL SISTEMA")
    print("==========================================")

    print("\nCLIENTES REGISTRADOS:")
    for cliente in sistema.listar_clientes():
        print(cliente)

    print("\nSERVICIOS REGISTRADOS:")
    for servicio in sistema.listar_servicios():
        print(servicio)

    print("\nRESERVAS REGISTRADAS:")
    for reserva in sistema.listar_reservas():
        print(reserva)
        print("------------------------------------------")

    logger.info("Ejecucion del sistema finalizada.")

    print("\nSistema Software FJ finalizado.")
    print("Los eventos y errores se registraron en el archivo de log.")


# ==========================================
# PUNTO DE ENTRADA DEL PROGRAMA
# ==========================================

if __name__ == "__main__":
    iniciar_sistema()
