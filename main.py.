    # OPERACION 3: Intentar registrar cliente invalido
    ejecutar_operacion(
        3,
        "Registrar cliente con correo invalido",
        lambda: sistema.registrar_cliente(
            Cliente(
                "C003",
                "Pedro Lopez",
                "correo_incorrecto",
                "3201234567"
